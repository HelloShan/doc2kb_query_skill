# doc2kb 构建端配置示例
# ========================
# 把这个文件复制成同目录下的 .env（不要加 .example 后缀）即可生效。
# .env 不会被提交到 GitHub（已在 .gitignore 里），每个部署环境自己维护
# 自己的一份；改配置直接改 .env 里的值，不用碰 config.py 本身。
#
# 下面只列出了会被 config.py 用到的变量，未设置的项会用 config.py 里
# 写死的默认值（和这里列出的默认值一致）。
#
# 注意：query_reference/ 目录下的查询服务用的是它自己完全独立的一份
# .env（参考 query_reference/.env.example，由 query_config.py 读取），
# 两边互不 import。包括 EMBEDDING_MODEL 在内的所有参数都要在两边各自
# 配置一份——查询端启动时会自动校验配置的模型输出维度和知识库实际
# 存的向量维度是否一致，不一致会有清楚的报错，但配置本身还是需要你
# 自己保证两边同步（改了构建端的 EMBEDDING_MODEL，记得也去改
# query_reference/.env 里的 DOC2KB_QUERY_EMBEDDING_MODEL）。

# ---------- 目录路径 ----------
DOC2KB_SOURCE_DIR=../source_docs
DOC2KB_OUTPUT_MD_DIR=../output_md
DOC2KB_DB_PATH=../doc2kb.lancedb
DOC2KB_STATE_FILE=../pipeline_state.json
# DOC2KB_LOG_FILE=pipeline_20260101.log   # 不设置则按当天日期自动生成

# ---------- HuggingFace 镜像 ----------
# 国内服务器访问 huggingface.co 经常不稳定，默认走镜像站；
# 如果你的服务器能直连官方源（比如海外服务器），可以设置成:
# DOC2KB_HF_ENDPOINT=https://huggingface.co
DOC2KB_HF_ENDPOINT=https://hf-mirror.com
# 缓存目录路径（支持相对路径，例如本地的 .cache 目录）
DOC2KB_CACHE_DIR=../model_cache

# ---------- 文档转换 ----------
DOC2KB_CONVERT_ENGINE=docling
DOC2KB_MAX_MD_FILE_SIZE_KB=500

# ---------- Embedding 模型 / 知识库"身份"参数 ----------
# 换模型一定要同步改 VECTOR_DIM 和 EMBEDDING_MAX_TOKENS，并且删掉旧的
# LanceDB 目录重新用 `python doc_pipeline.py build --full` 全量重建，
# 否则会报向量维度不匹配的错误。
#
# 已知在当前 fastembed 版本里实际可用的中文/多语言模型（实测确认过，
# bge-base-zh-v1.5/bge-large-zh-v1.5/bge-m3 这版 fastembed 都不支持）：
#   BAAI/bge-small-zh-v1.5          dim=512  max_tokens=512   （默认，最快）
#   jinaai/jina-embeddings-v2-base-zh  dim=768  max_tokens=8192  （中英双语，长文本）
DOC2KB_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
DOC2KB_VECTOR_DIM=768
DOC2KB_EMBEDDING_MAX_TOKENS=8192

DOC2KB_CHUNK_SIZE=1200
DOC2KB_CHUNK_OVERLAP=300
DOC2KB_TABLE_NAME=docs

# 术语表（可选），不设置/文件不存在时功能自动跳过
DOC2KB_GLOSSARY_PATH=../glossary.yaml

# ---------- 并发与内存 ----------
DOC2KB_CONVERT_WORKERS=4
DOC2KB_EMBED_BATCH_SIZE=32
DOC2KB_DB_FLUSH_INTERVAL=20
DOC2KB_LARGE_FILE_THRESHOLD_MB=50
DOC2KB_CONVERT_TIMEOUT=600

# ---------- 乱码检测 ----------
DOC2KB_GARBLED_PUNCT_THRESHOLD=3
DOC2KB_GARBLED_CHECK_BYTES=2000

# ---------- 输出 ----------
DOC2KB_COLOR_OUTPUT=true
