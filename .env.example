# doc2kb_query skill 配置
# ==========================
# 把这个文件复制成 .env（去掉 .example 后缀）即可生效。

# 知识库路径：建议用绝对路径
DOC2KB_QUERY_DB_PATH=./make_lancedb/doc2kb.lancedb

DOC2KB_QUERY_TABLE_NAME=docs

# ---------- 知识库身份参数（必须和构建端保持一致） ----------
# ⚠️ 这几项必须和 doc2kb 构建时的配置完全一致，否则会报维度不匹配错误。
# 启动时会自动探测模型输出维度和知识库实际维度是否一致，不一致会立刻报错。

# 已知在当前 fastembed 版本里实际可用的中文/多语言模型：
#   BAAI/bge-small-zh-v1.5            dim=512  max_tokens=512   （默认，轻量）
#   jinaai/jina-embeddings-v2-base-zh  dim=768  max_tokens=8192  （中英双语，长文本）

DOC2KB_QUERY_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
DOC2KB_QUERY_EMBEDDING_MAX_TOKENS=8192

# ---------- HuggingFace 镜像 ----------
# 国内服务器访问 huggingface.co 经常不稳定，默认走镜像站；
# 如果你的服务器能直连官方源（比如海外服务器），可以设置成:
# DOC2KB_HF_ENDPOINT=https://huggingface.co
DOC2KB_HF_ENDPOINT=https://hf-mirror.com

# 术语表（可选），不设置/文件不存在时自动跳过
DOC2KB_QUERY_GLOSSARY_PATH=../glossary.yaml

# ---------- 检索参数 ----------
DOC2KB_QUERY_TOP_K=5
DOC2KB_QUERY_SIMILARITY_THRESHOLD=0.5

# ---------- 服务监听 ----------
DOC2KB_QUERY_HOST=127.0.0.1
DOC2KB_QUERY_PORT=8788
# 如果这台机器上同时部署了多个知识库（分发给多人/多个项目各自使用时
# 很常见），大家的默认端口大概率都是 8788。不用手动协调端口——脚本会
# 先校验端口上的 server 是不是"自己这个知识库"，如果不是，会在
# [PORT, PORT+此值) 范围内自动找一个空闲端口。只有确实想固定用哪个端口
# （比如要配置防火墙规则）时才需要手动改小范围或改 PORT。
DOC2KB_QUERY_PORT_SCAN_RANGE=10
# 等待常驻 server 就绪的超时（秒）。首次在一台新机器上运行、embedding
# 模型本地还没有缓存、需要联网下载时，可能远超默认值，可适当调大。
DOC2KB_QUERY_SERVER_START_TIMEOUT=120
DOC2KB_QUERY_IDLE_TIMEOUT=3600

# ---------- 访问口令（可选，对外暴露时强烈建议设置） ----------
# 生成方式: openssl rand -hex 32
DOC2KB_QUERY_AUTH_TOKEN=
